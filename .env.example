# ==========================================
# ⚖️ NyaySetu Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Supabase Postgres & Vector Storage
# ------------------------------------------
# Optional for local demo/evaluation. If left as default, NyaySetu automatically 
# falls back to the zero-config local In-Memory JSON store (data/corpus-index.json).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# 2. Local Ollama AI Configuration (On-Device RAG)
# ------------------------------------------
# Required: Ensure Ollama (https://ollama.com) is installed and running locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=120000
